# ==============================================================================
# IdeaForge Enterprise Environment Configuration (Backend)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MySQL 8.0+ or Managed Cloud MySQL / Aiven / RDS)
DB_HOST=your_mysql_host.example.com
DB_PORT=3306
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=ideaforge
DB_SSL=true

# Cryptographic Token Signing Secret (Minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_cryptographically_secure_random_jwt_secret_key_here

# Frontend / CORS Allowed Origins (Comma-separated for multiple domains)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# ==============================================================================
# Transactional Email Delivery (Choose ONE provider)
# ==============================================================================
# Option A: Google Gmail SMTP (Recommended for personal / rapid production use)
# 1. Enable 2-Step Verification in Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create app password named "IdeaForge" (generates a 16-character code)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_16_digit_app_password

# Option B: Resend API (Recommended for modern cloud microservices - resend.com)
# RESEND_API_KEY=re_your_resend_api_key_here

# Option C: Brevo API (brevo.com - 300 free emails/day)
# BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# Option D: Custom SMTP Server
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password

# Sender Details
MAIL_FROM=noreply@ideaforge.io
MAIL_FROM_NAME=IdeaForge
REQUIRE_EMAIL_VERIFY=true

# ==============================================================================
# OAuth 2.0 Authentication Providers (Optional, leave blank if not used)
# ==============================================================================
# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: http://localhost:5000/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App (GitHub Settings -> Developer Settings -> OAuth Apps)
# Authorization callback URL: http://localhost:5000/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Discord OAuth App (Discord Developer Portal -> Applications -> OAuth2)
# Redirect URL: http://localhost:5000/api/auth/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ==============================================================================
# AI Idea Assistant (Google Gemini API - aistudio.google.com)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
